<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="quikbar.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:quikbar"
    xmlns:helpers="using:quikbar.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="quikbar"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <helpers:StringToVisibilityConverter x:Key="StrVis" />

            <!-- Shared row look: full-width rounded highlight -->
            <Style x:Key="ResultRowStyle" TargetType="ListViewItem">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </Style>

            <DataTemplate x:Key="ResultRowTemplate">
                <Grid Padding="12,6" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="{Binding Glyph}" />
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding Subtitle}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding Subtitle, Converter={StaticResource StrVis}}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{Binding Hint}" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search header -->
        <Grid x:Name="SearchHeaderGrid" Grid.Row="0" Padding="14,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="SearchBox"
                Grid.Column="1"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                FontSize="17"
                PlaceholderText="Search for apps and commands..."
                TextChanged="SearchBox_TextChanged">
                <TextBox.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.MergedDictionaries>
                            <ResourceDictionary Source="ms-appx:///Styles/GhostTextBox.xaml" />
                        </ResourceDictionary.MergedDictionaries>
                    </ResourceDictionary>
                </TextBox.Resources>
            </TextBox>
            <Button
                x:Name="ClearButton"
                Grid.Column="2"
                Style="{StaticResource IconButton}"
                Padding="6"
                Click="ClearButton_Click"
                ToolTipService.ToolTip="Clear"
                Visibility="Collapsed">
                <FontIcon FontSize="14" Glyph="&#xE711;" />
            </Button>
            <StackPanel
                Grid.Column="3"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Quick AI" />
                <Border Style="{StaticResource KeyCap}">
                    <TextBlock Style="{StaticResource KeyCapText}" Text="Tab" />
                </Border>
            </StackPanel>
        </Grid>

        <Border x:Name="TopDivider" Grid.Row="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

        <!-- Results -->
        <ScrollViewer
            x:Name="ResultsScroll"
            Grid.Row="2"
            Padding="0,2,0,6"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock
                    x:Name="SuggestionsHeader"
                    Style="{StaticResource GroupHeader}"
                    Text="Suggestions" />
                <ListView
                    x:Name="SuggestionsList"
                    Padding="10,0"
                    Background="Transparent"
                    BorderThickness="0"
                    IsItemClickEnabled="True"
                    ItemClick="OnResultClick"
                    ItemContainerStyle="{StaticResource ResultRowStyle}"
                    ItemTemplate="{StaticResource ResultRowTemplate}"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectionMode="Single">
                    <ListView.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.MergedDictionaries>
                                <ResourceDictionary Source="ms-appx:///Styles/ResultSelection.xaml" />
                            </ResourceDictionary.MergedDictionaries>
                        </ResourceDictionary>
                    </ListView.Resources>
                </ListView>
                <TextBlock
                    x:Name="CommandsHeader"
                    Style="{StaticResource GroupHeader}"
                    Margin="16,10,16,4"
                    Text="Commands" />
                <ListView
                    x:Name="CommandsList"
                    Padding="10,0"
                    Background="Transparent"
                    BorderThickness="0"
                    IsItemClickEnabled="True"
                    ItemClick="OnResultClick"
                    ItemContainerStyle="{StaticResource ResultRowStyle}"
                    ItemTemplate="{StaticResource ResultRowTemplate}"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectionMode="Single">
                    <ListView.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.MergedDictionaries>
                                <ResourceDictionary Source="ms-appx:///Styles/ResultSelection.xaml" />
                            </ResourceDictionary.MergedDictionaries>
                        </ResourceDictionary>
                    </ListView.Resources>
                </ListView>
                <TextBlock
                    x:Name="EmptyText"
                    Margin="0,12"
                    HorizontalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="No results"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <!-- AI answer view (replaces the whole launcher chrome) -->
        <Border
            x:Name="AiPanel"
            Grid.Row="2"
            Padding="16,14,16,12"
            Background="Transparent"
            Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title bar: back, question + model, conversations, spinner, copy.
                     Also the window drag region in AI mode (see SetTitleBar). -->
                <Grid x:Name="AiTitleBarGrid" Grid.Row="0" Margin="0,0,0,12" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="AiBackButton"
                        Style="{StaticResource IconButton}"
                        Padding="8,4"
                        Click="AiBackButton_Click"
                        ToolTipService.ToolTip="Back">
                        <FontIcon FontSize="16" Glyph="&#xE76B;" />
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            x:Name="AiTitle"
                            MaxLines="1"
                            FontSize="15"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="AiSubtitle"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox
                        x:Name="AiConvoBox"
                        Grid.Column="2"
                        MaxWidth="220"
                        VerticalAlignment="Center"
                        DisplayMemberPath="Title"
                        ToolTipService.ToolTip="Conversations" />
                    <ProgressRing
                        x:Name="AiSpinner"
                        Grid.Column="3"
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="AiPopoutButton"
                        Grid.Column="4"
                        Style="{StaticResource IconButton}"
                        Click="AiPopoutButton_Click"
                        ToolTipService.ToolTip="Copy answer">
                        <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                    </Button>
                </Grid>

                <!-- Query pill -->
                <Border
                    x:Name="AiQueryPillBorder"
                    Grid.Row="1"
                    Margin="0,0,0,12"
                    Padding="14,7"
                    HorizontalAlignment="Right"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    CornerRadius="15">
                    <TextBlock
                        x:Name="AiQueryPill"
                        FontSize="13" />
                </Border>

                <!-- Answer -->
                <ScrollViewer
                    x:Name="AiScroll"
                    Grid.Row="2"
                    Padding="0,0,14,0"
                    VerticalScrollBarVisibility="Auto">
                    <RichTextBlock
                        x:Name="AiAnswer"
                        FontSize="14"
                        IsTextSelectionEnabled="True"
                        LineHeight="23" />
                </ScrollViewer>

                <!-- Bottom ask bar -->
                <Grid Grid.Row="3" Margin="0,10,0,0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="AiNewButton"
                        Style="{StaticResource IconButton}"
                        Width="40"
                        Height="40"
                        Padding="0"
                        Click="AiNewButton_Click"
                        CornerRadius="20"
                        ToolTipService.ToolTip="New chat">
                        <FontIcon FontSize="16" Glyph="&#xE710;" />
                    </Button>
                    <Border
                        Grid.Column="1"
                        Padding="14,4"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="20">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="AiInput"
                                MinHeight="32"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="14"
                                KeyDown="AiInput_KeyDown"
                                PlaceholderText="Ask anything, @ tools, or / for commands...">
                                <TextBox.Resources>
                                    <ResourceDictionary>
                                        <ResourceDictionary.MergedDictionaries>
                                            <ResourceDictionary Source="ms-appx:///Styles/GhostTextBox.xaml" />
                                        </ResourceDictionary.MergedDictionaries>
                                    </ResourceDictionary>
                                </TextBox.Resources>
                            </TextBox>
                            <Button
                                x:Name="SendButton"
                                Grid.Column="1"
                                Style="{StaticResource IconButton}"
                                Padding="6"
                                VerticalAlignment="Center"
                                Click="SendButton_Click"
                                ToolTipService.ToolTip="Send (Enter)">
                                <FontIcon FontSize="14" Glyph="&#xE724;" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="BottomDivider" Grid.Row="3" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

        <!-- Footer (also the window drag region in search mode) -->
        <Grid x:Name="FooterGrid" Grid.Row="4" Padding="14,9,4,2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE713;" />
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Text="Open Command" />
                <Border Style="{StaticResource KeyCap}">
                    <TextBlock Style="{StaticResource KeyCapText}" Text="&#x21B5;" />
                </Border>
                <Border
                    Width="1"
                    Height="14"
                    Margin="6,0"
                    Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Text="Actions" />
                <Border Style="{StaticResource KeyCap}">
                    <TextBlock Style="{StaticResource KeyCapText}" Text="Ctrl" />
                </Border>
                <Border Style="{StaticResource KeyCap}">
                    <TextBlock Style="{StaticResource KeyCapText}" Text="K" />
                </Border>
            </StackPanel>
            <!-- Resize grip: drag to resize (border edges work too) -->
            <Border
                x:Name="ResizeGrip"
                Grid.Column="2"
                Width="28"
                Height="28"
                VerticalAlignment="Bottom"
                Background="Transparent"
                PointerPressed="ResizeGrip_Pressed"
                PointerMoved="ResizeGrip_Moved"
                PointerReleased="ResizeGrip_Released"
                PointerCanceled="ResizeGrip_Released"
                ToolTipService.ToolTip="Drag to resize">
                <Path
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                    StrokeThickness="1.5"
                    Data="M7,21 L21,7 M12,21 L21,12 M17,21 L21,17" />
            </Border>
        </Grid>
    </Grid>
</Window>
