<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="quikbar.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:quikbar">
    <Application.Resources>
        <ResourceDictionary>
            <!-- App-wide typeface: bundled Geist (FontIcon keeps SymbolThemeFontFamily). -->
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Geist-Variable.ttf#Geist</FontFamily>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Shared component styles -->
                <ResourceDictionary Source="ms-appx:///Styles/LauncherStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
